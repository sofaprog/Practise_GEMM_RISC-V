# Что НЕ попадает в git из папки diploma/
# бинарники: собираются scripts/build.sh
build/
# заголовки с матрицами: генерируются из .mtx
gen/
# сырые папки запусков gem5 (stats.txt и т.п.): большие; в git идут только CSV, PNG, .asm
results/*/
# архивы для пересылки
*.tar.gz
__pycache__/
# рабочие заметки к старому отчёту, не для репозитория
docs/report_corrections.md
